# Example environment for the Obol self-hosted central server.
# Usage: copy to .env.self-hosted, fill the values, then run compose with
#   docker compose -f docker-compose.self-hosted.yml --env-file .env.self-hosted <command>
#
# The compose file forwards exactly these variables to the BFF container and
# fails during `docker compose config`/`up` when a required value is missing
# or empty. PocketBase's internal URL is fixed inside the compose network and
# is not listed here. The PocketBase container itself receives none of these
# variables: its superuser credentials stay with the BFF and SMTP settings are
# applied by the BFF through the authenticated PocketBase settings API.
#
# Do not commit real values: keep secrets in a password manager, never in git.

# ---------------------------------------------------------------------------
# Required: deployment identity (D009)
# ---------------------------------------------------------------------------

# Public https URL of this deployment, as reachable by the clients. It is the
# host the TLS proxy serves: `https://HOST/` is the web client and
# `https://HOST/api/*` the BFF. It signs the D6 Origin/CSRF check, is
# reflected in some API responses, and becomes the PocketBase meta.appURL that
# password-reset email links are built from (they must land on
# `https://HOST/?resetToken=...`, i.e. the same host). Must match the TLS
# certificate you install: scheme + host + exact port, no trailing slash.
OBOL_PUBLIC_URL=

# Session signing secret, independent of every PocketBase password
# (D009 D7). Generate once with:
#   openssl rand -hex 32
# Rotating it is the global revocation switch: it invalidates every session
# token of every signed-in device at once.
OBOL_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Required: PocketBase superuser credentials (server-internal, D009 D7)
# ---------------------------------------------------------------------------

# Used by the BFF process to authenticate against the private PocketBase, and
# by you only on the server for recovery paths. Never embedded in or shown to
# any client. There is no default and no fallback: nothing is created until
# you set both.
#
# Namespaced `OBOL_PB_ADMIN_*` (not the server's internal `PB_ADMIN_*`
# spellings) because dev environments and hosting shells commonly export
# `PB_ADMIN_EMAIL`/`PB_ADMIN_PASSWORD` for the dev stack, and Compose
# interpolation would prefer those shell variables over this file's values.
# Compose forwards these into the BFF's server-internal PB_ADMIN_* variables.
#
# PocketBase requires a strong password (at least 12 characters).
OBOL_PB_ADMIN_EMAIL=
OBOL_PB_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Optional: client origin allowlist (D009 D6)
# ---------------------------------------------------------------------------

# Comma-separated exact origins (scheme + host + port) allowed via CORS.
# The hosted web client is same-origin through the reverse proxy and needs no
# entry. The Electrobun renderer is loaded from `views://mainview/index.html`;
# desktop remote mode uses browser fetches from that WebView, so include its
# `views://mainview` origin. The native iOS client uses WKWebView fetch and
# sends `Origin: capacitor://localhost`, so include that origin when serving
# iOS. For both remote desktop and iOS, use:
#   OBOL_CLIENT_ORIGINS=views://mainview,capacitor://localhost
# Remove origins for clients this server will not serve. Requests without an
# Origin header (curl, API tools) bypass the CORS check. Entries must match
# exactly; a wildcard is never allowed.
OBOL_CLIENT_ORIGINS=views://mainview,capacitor://localhost

# ---------------------------------------------------------------------------
# Optional: first-run setup token (D009 D4)
# ---------------------------------------------------------------------------

# Leave empty (the normal case): at every boot before an owner account exists
# the BFF generates a one-time 32-hex token, prints it to its container logs,
# and accepts it for 30 minutes to create the single owner account through
# POST /api/setup/init. Set a value here only to pin a static token instead
# of reading it from the logs (it becomes the presenter's proof of server
# access, so store it like a secret).
OBOL_SETUP_TOKEN=

# ---------------------------------------------------------------------------
# Optional: owner password-reset mail (D009 D5 -> PocketBase SMTP settings)
# ---------------------------------------------------------------------------

# When PB_SMTP_HOST is set, the BFF applies these values to the PocketBase
# SMTP settings through its authenticated settings API at every boot
# (validation in server/src/infrastructure/plugins/pocketbase.ts). Leaving
# PB_SMTP_HOST empty changes nothing: self-service password reset is then
# unavailable and owner recovery is manual again (docs/self-hosting.md).

# SMTP relay hostname or IP; no URL, no slashes. Required to enable mail.
PB_SMTP_HOST=

# Relay port. Required whenever PB_SMTP_HOST is set; integer 1-65535.
# Typical: 587 for StartTLS relays, 465 for relays with TLS from first byte.
PB_SMTP_PORT=

# Credentials for the relay. Optional: send only when the relay needs
# authentication. Values are stored in PocketBase settings, never logged.
PB_SMTP_USERNAME=
PB_SMTP_PASSWORD=

# TLS mode (PocketBase semantics): true enforces TLS for the relay
# connection from the first byte (typical for port 465); false sends the
# StartTLS command and lets the relay decide (typical for port 587).
# Optional, default false.
PB_SMTP_TLS=

# AUTH method: PLAIN (PocketBase default) or LOGIN. Optional.
PB_SMTP_AUTH_METHOD=

# Domain name or IP sent in the EHLO/HELO exchange; PocketBase defaults to
# "localhost" and some relays require your own. Optional.
PB_SMTP_LOCAL_NAME=

# ---------------------------------------------------------------------------
# Optional: BFF host port
# ---------------------------------------------------------------------------

# Port on the host where the BFF is published (loopback bind only). The
# reverse proxy forwards /api/* here. Optional; default 8080.
BFF_PORT=8080

# ---------------------------------------------------------------------------
# Optional: web client host port
# ---------------------------------------------------------------------------

# Port on the host where the hosted Nuxt web client is published (loopback
# bind only). The reverse proxy forwards every non-/api path here.
# Optional; default 3000.
WEB_PORT=3000
