      "~~/*": [
        "./*"
      ],
      "@@": [
        "."
      ],
      "@@/*": [
        "./*"
      ],
      "#shared": [
        "./shared"
      ],
      "#shared/*": [
        "./shared/*"
      ],
      "assets": [
        "./assets"
      ],
      "assets/*": [
        "./assets/*"
      ],
      "public": [
        "./public"
      ],
      "public/*": [
        "./public/*"
      ],
      "#server": [
        "./server"
      ],
      "#server/*": [
        "./server/*"
      ],
      "#app": [
        "./node_modules/nuxt/dist/app"
      ],
      "#app/*": [
        "./node_modules/nuxt/dist/app/*"
      ],
      "vue-demi": [
        "./node_modules/nuxt/dist/app/compat/vue-demi"
      ],
      "#ui": [
        "./node_modules/@nuxt/ui/dist/runtime"
      ],
      "#ui/*": [
        "./node_modules/@nuxt/ui/dist/runtime/*"
      ],
      "#ui-colors": [
        "./.nuxt/ui.colors"
      ],
      "#color-mode-options": [
        "./.nuxt/color-mode-options.mjs"
      ],
      "#vue-router": [
        "./node_modules/vue-router"
      ],
      "#unhead/composables": [
        "./node_modules/nuxt/dist/head/runtime/composables/v3"
      ],
      "#imports": [
        "./.nuxt/imports"
      ],
      "#tailwind-config": [
        "./.nuxt/tailwind/expose"
      ],
      "#tailwind-config/*": [
        "./.nuxt/tailwind/expose/*"
      ],
      "#app-manifest": [
        "./.nuxt/manifest/meta/520b050b-5004-49e4-b79d-2f3d7bb99c54.json"
      ],
      "#components": [
        "./.nuxt/components"
      ],
      "#build": [
        "./.nuxt"
      ],
      "#build/*": [
        "./.nuxt/*"
