{
  "extends": "./.hutch/devkit/tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["bun-types"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["electrobun/**/*.ts", "scripts/**/*.ts"]
}
